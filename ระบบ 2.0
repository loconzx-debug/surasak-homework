<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบตรวจเช็คการบ้าน & ตารางเรียน - ม.3/13 โรงเรียนสุรศักดิ์มนตรี</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Prompt', sans-serif; background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%); background-attachment: fixed; min-height: 100vh; }
        .glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.7); box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15); }
    </style>
</head>
<body class="p-4 pb-12">
    <div class="max-w-md mx-auto space-y-4">
        
        <!-- Header -->
        <div class="glass-card rounded-2xl p-4 text-center shadow-lg">
            <h1 class="text-xl font-bold text-indigo-900">📚 ระบบตรวจเช็คการบ้าน (ม.3/13)</h1>
            <p class="text-xs text-gray-600 mt-1">โรงเรียนสุรศักดิ์มนตรี (เรียลไทม์ซิงค์)</p>
        </div>

        <!-- ตารางเรียน -->
        <div class="glass-card rounded-2xl p-4 shadow-lg">
            <h2 class="text-xs font-bold text-gray-800 mb-2">📅 ตารางเรียนประจำสัปดาห์</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-[11px] text-left text-gray-700 min-w-[450px]">
                    <thead class="bg-indigo-600 text-white rounded-lg">
                        <tr>
                            <th class="p-2 rounded-l-lg">วัน/คาบ</th>
                            <th class="p-2">1</th>
                            <th class="p-2">2</th>
                            <th class="p-2">3</th>
                            <th class="p-2 rounded-r-lg">4</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <tr><td class="font-semibold p-2">จันทร์</td><td class="p-2">คณิตศาสตร์</td><td class="p-2">ภาษาไทย</td><td class="p-2">วิทยาศาสตร์</td><td class="p-2">อังกฤษ</td></tr>
                        <tr><td class="font-semibold p-2">อังคาร</td><td class="p-2">สังคมศึกษา</td><td class="p-2">ประวัติศาสตร์</td><td class="p-2">สุขศึกษา</td><td class="p-2">การงานฯ</td></tr>
                        <tr><td class="font-semibold p-2">พุธ</td><td class="p-2">วิทยาศาสตร์</td><td class="p-2">คณิตศาสตร์</td><td class="p-2">ศิลปะ</td><td class="p-2">ภาษาไทย</td></tr>
                        <tr><td class="font-semibold p-2">พฤหัสฯ</td><td class="p-2">ภาษาอังกฤษ</td><td class="p-2">สังคมฯ</td><td class="p-2">ดนตรี/นาฏศิลป์</td><td class="p-2">แนะแนว</td></tr>
                        <tr><td class="font-semibold p-2">ศุกร์</td><td class="p-2">กิจกรรมฯ</td><td class="p-2">ลูกเสือ</td><td class="p-2">ชุมนุม</td><td class="p-2">-</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ส่วนสั่งการบ้าน (Admin/ผู้ดูแล) -->
        <div class="glass-card rounded-2xl p-4 shadow-lg space-y-3">
            <h2 class="text-xs font-bold text-gray-800"><i class="fa-solid fa-pen-to-square text-indigo-600"></i> เพิ่มรายการการบ้านใหม่</h2>
            <input type="text" id="subjectInput" placeholder="วิชา (เช่น ค23102)" class="w-full text-xs p-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none">
            <input type="text" id="taskInput" placeholder="งานที่ต้องทำ (เช่น แบบฝึกหัดหน้า 45)" class="w-full text-xs p-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none">
            <button onclick="addNewTask()" class="w-full bg-pink-600 text-white text-xs font-bold py-2.5 rounded-lg shadow hover:bg-pink-700 transition">
                <i class="fa-solid fa-cloud-arrow-up"></i> บันทึกการบ้าน (ทุกคนเห็นทันที)
            </button>
        </div>

        <!-- รายการการบ้านเรียลไทม์ -->
        <div class="glass-card rounded-2xl p-4 shadow-lg space-y-3">
            <div class="flex justify-between items-center">
                <h2 class="text-xs font-bold text-gray-800">📋 เช็คลิสต์การบ้านทั้งหมด</h2>
                <button onclick="fetchTasks()" class="text-[10px] bg-indigo-100 text-indigo-700 px-2 py-1 rounded-md font-semibold"><i class="fa-solid fa-rotate"></i> รีเฟรช</button>
            </div>
            <div id="liveHomeworkList" class="space-y-2">
                <p class="text-xs text-gray-400 text-center py-3">กำลังโหลดข้อมูลจากระบบกลาง...</p>
            </div>
        </div>

        <!-- ปุ่ม Admin -->
        <div class="text-center pt-1">
            <button onclick="alert('โหมด Admin: พร้อมใช้งาน')" class="bg-indigo-700 text-white text-xs font-bold px-6 py-2 rounded-full shadow-md hover:bg-indigo-800 transition">
                <i class="fa-solid fa-key"></i> เข้าสู่ระบบ Admin
            </button>
        </div>

    </div>

    <script>
        // ระบบคลาวด์กลางส่วนตัวสำหรับซิงค์การบ้านห้อง ม.3/13
        const BIN_ID = "6704975fae38da327eb84518"; 
        const API_KEY = "$2a$10$7R5v3m6z5x8c9v0b1n2m3u4i5o6p7l8k9j0h1g2f3d4s5a6q7w8e9"; 

        document.addEventListener("DOMContentLoaded", () => {
            fetchTasks();
            setInterval(fetchTasks, 4000); // อัปเดตข้อมูลอัตโนมัติทุก 4 วินาที ทุกคนเห็นพร้อมกัน
        });

        async function fetchTasks() {
            try {
                let res = await fetch(`https://api.jsonbin.io/v3/b/${BIN_ID}/latest`, {
                    headers: { 'X-Master-Key': API_KEY }
                });
                let data = await res.json();
                renderTasks(data.record.tasks || []);
            } catch (err) {
                console.log("Error loading data");
            }
        }

        async function addNewTask() {
            const subject = document.getElementById('subjectInput').value.trim();
            const task = document.getElementById('taskInput').value.trim();

            if (!subject || !task) {
                alert('กรุณากรอกวิชาและรายละเอียดงานให้ครบถ้วนครับ!');
                return;
            }

            try {
                let res = await fetch(`https://api.jsonbin.io/v3/b/${BIN_ID}/latest`, {
                    headers: { 'X-Master-Key': API_KEY }
                });
                let data = await res.json();
                let currentTasks = data.record.tasks || [];

                const newTask = {
                    id: Date.now(),
                    subject: subject,
                    task: task,
                    time: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })
                };

                currentTasks.unshift(newTask);

                await fetch(`https://api.jsonbin.io/v3/b/${BIN_ID}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Master-Key': API_KEY
                    },
                    body: JSON.stringify({ tasks: currentTasks })
                });

                document.getElementById('subjectInput').value = '';
                document.getElementById('taskInput').value = '';
                
                fetchTasks();
                alert('บันทึกสำเร็จ! เพื่อนทุกคนเปิดเว็บมาจะเห็นการบ้านนี้ทันที');
            } catch (e) {
                alert('เกิดข้อผิดพลาดในการบันทึก ลองใหม่อีกครั้ง');
            }
        }

        function renderTasks(tasks) {
            const container = document.getElementById('liveHomeworkList');
            if (tasks.length === 0) {
                container.innerHTML = '<p class="text-xs text-gray-500 text-center py-3">ยังไม่มีรายการการบ้านในระบบ</p>';
                return;
            }

            container.innerHTML = '';
            tasks.forEach(item => {
                const div = document.createElement('div');
                div.className = 'p-3 rounded-xl border border-indigo-100 bg-white shadow-sm flex justify-between items-start';
                div.innerHTML = `
                    <div>
                        <span class="text-xs font-bold text-indigo-700 block"><i class="fa-solid fa-bookmark"></i> ${item.subject}</span>
                        <span class="text-xs text-gray-800 font-medium block mt-0.5">${item.task}</span>
                        <span class="text-[10px] text-gray-400 mt-1 block">สั่งเมื่อ: ${item.time || 'เมื่อสักครู่'}</span>
                    </div>
                `;
                container.appendChild(div);
            });
        }
    </script>
</body>
</html>
