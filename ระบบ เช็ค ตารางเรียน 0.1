<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบตรวจเช็คการบ้าน & ตารางเรียน - โรงเรียนสุรศักดิ์มนตรี</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Prompt และ Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
            background-attachment: fixed;
            min-height: 100vh;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.12);
        }
    </style>
</head>
<body class="p-4 pb-12">
    <div class="max-w-md mx-auto space-y-4">
        
        <!-- Header -->
        <div class="glass-card rounded-2xl p-4 text-center shadow-lg">
            <h1 class="text-xl font-bold text-indigo-900">📚 ระบบตรวจเช็คการบ้าน (ม.3/13)</h1>
            <p class="text-xs text-gray-600 mt-1">โรงเรียนสุรศักดิ์มนตรี ภาคเรียนที่ 2 ปีการศึกษา 2569</p>
        </div>

        <!-- ตารางเรียน (ปรับให้เลื่อนดูบนมือถือได้ไม่ตกขอบ) -->
        <div class="glass-card rounded-2xl p-4 shadow-lg">
            <h2 class="text-sm font-bold text-gray-800 mb-2">📅 ตารางเรียนประจำสัปดาห์</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-gray-700 min-w-[500px]">
                    <thead class="bg-indigo-600 text-white rounded-lg">
                        <tr>
                            <th class="p-2 rounded-l-lg">วัน / คาบ</th>
                            <th class="p-2">1 (08:10)</th>
                            <th class="p-2">2 (09:00)</th>
                            <th class="p-2">3 (09:50)</th>
                            <th class="p-2 rounded-r-lg">4 (10:40)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <tr>
                            <td class="font-semibold p-2">จันทร์</td>
                            <td class="p-2">คณิตศาสตร์</td>
                            <td class="p-2">ภาษาไทย</td>
                            <td class="p-2">วิทยาศาสตร์</td>
                            <td class="p-2">อังกฤษ</td>
                        </tr>
                        <tr>
                            <td class="font-semibold p-2">อังคาร</td>
                            <td class="p-2">สังคมศึกษา</td>
                            <td class="p-2">ประวัติศาสตร์</td>
                            <td class="p-2">สุขศึกษา</td>
                            <td class="p-2">การงานฯ</td>
                        </tr>
                        <tr>
                            <td class="font-semibold p-2">พุธ</td>
                            <td class="p-2">วิทยาศาสตร์</td>
                            <td class="p-2">คณิตศาสตร์</td>
                            <td class="p-2">ศิลปะ</td>
                            <td class="p-2">ภาษาไทย</td>
                        </tr>
                        <tr>
                            <td class="font-semibold p-2">พฤหัสฯ</td>
                            <td class="p-2">ภาษาอังกฤษ</td>
                            <td class="p-2">สังคมฯ</td>
                            <td class="p-2">ดนตรี/นาฏศิลป์</td>
                            <td class="p-2">แนะแนว</td>
                        </tr>
                        <tr>
                            <td class="font-semibold p-2">ศุกร์</td>
                            <td class="p-2">กิจกรรมพัฒนาผู้เรียน</td>
                            <td class="p-2">ลูกเสือ/เนตรนารี</td>
                            <td class="p-2">ชุมนุม</td>
                            <td class="p-2">-</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- เช็คลิสต์การบ้าน & ฟอร์มสั่งงาน -->
        <div class="glass-card rounded-2xl p-4 shadow-lg space-y-4">
            <h2 class="text-sm font-bold text-gray-800">📝 เช็คลิสต์การบ้านประจำวัน</h2>
            
            <!-- ฟอร์มเพิ่มการบ้าน -->
            <div class="bg-white/60 p-3 rounded-xl space-y-2 border border-white">
                <p class="text-xs font-semibold text-indigo-700"><i class="fa-solid fa-plus-circle"></i> สั่งการบ้านประจำวัน (พิมพ์แล้วกดบันทึก)</p>
                <input type="text" id="subjectInput" placeholder="วิชา (เช่น ค23102)" class="w-full text-xs p-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <input type="text" id="taskInput" placeholder="งานที่ต้องทำ (เช่น แบบฝึกหัดบทที่ 1)" class="w-full text-xs p-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <button onclick="addHomework()" class="w-full bg-pink-600 text-white text-xs font-bold py-2 rounded-lg shadow hover:bg-pink-700 transition">
                    เพิ่มรายการการบ้านประจำวัน
                </button>
            </div>

            <!-- แสดงรายการการบ้าน -->
            <div id="homeworkList" class="space-y-2">
                <!-- รายการจะถูกเพิ่มตรงนี้อัตโนมัติ -->
            </div>
        </div>

        <!-- ปุ่ม Admin -->
        <div class="text-center pt-2">
            <button onclick="alert('โหมดผู้ดูแลระบบ (Admin Mode พร้อมใช้งาน)')" class="bg-indigo-700 text-white text-xs font-bold px-6 py-2.5 rounded-full shadow-md hover:bg-indigo-800 transition">
                <i class="fa-solid fa-key"></i> เข้าสู่ระบบ Admin
            </button>
        </div>

    </div>

    <script>
        // โหลดข้อมูลการบ้านที่บันทึกไว้
        document.addEventListener("DOMContentLoaded", loadHomework);

        function addHomework() {
            const subject = document.getElementById('subjectInput').value.trim();
            const task = document.getElementById('taskInput').value.trim();

            if (!subject || !task) {
                alert('กรุณากรอกข้อมูลให้ครบถ้วนครับ!');
                return;
            }

            const newItem = {
                id: Date.now(),
                subject: subject,
                task: task,
                completed: false
            };

            let homeworks = JSON.parse(localStorage.getItem('surasak_homeworks')) || [];
            homeworks.push(newItem);
            localStorage.setItem('surasak_homeworks', JSON.stringify(homeworks));

            document.getElementById('subjectInput').value = '';
            document.getElementById('taskInput').value = '';
            
            loadHomework();
        }

        function loadHomework() {
            const listContainer = document.getElementById('homeworkList');
            let homeworks = JSON.parse(localStorage.getItem('surasak_homeworks')) || [];

            if (homeworks.length === 0) {
                listContainer.innerHTML = '<p class="text-xs text-gray-500 text-center py-2">ยังไม่มีรายการการบ้านในระบบ</p>';
                return;
            }

            listContainer.innerHTML = '';
            homeworks.forEach(item => {
                const div = document.createElement('div');
                div.className = `p-3 rounded-xl border flex justify-between items-center bg-white/80 shadow-sm ${item.completed ? 'opacity-60 line-through' : ''}`;
                div.innerHTML = `
                    <div>
                        <span class="text-xs font-bold text-indigo-700 block">${item.subject}</span>
                        <span class="text-xs text-gray-800">${item.task}</span>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="toggleTask(${item.id})" class="text-xs px-2 py-1 bg-green-500 text-white rounded">${item.completed ? 'ยังไม่เสร็จ' : 'เสร็จแล้ว'}</button>
                        <button onclick="deleteTask(${item.id})" class="text-xs px-2 py-1 bg-red-500 text-white rounded"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
                listContainer.appendChild(div);
            });
        }

        function toggleTask(id) {
            let homeworks = JSON.parse(localStorage.getItem('surasak_homeworks')) || [];
            homeworks = homeworks.map(item => {
                if (item.id === id) item.completed = !item.completed;
                return item;
            });
            localStorage.setItem('surasak_homeworks', JSON.stringify(homeworks));
            loadHomework();
        }

        function deleteTask(id) {
            let homeworks = JSON.parse(localStorage.getItem('surasak_homeworks')) || [];
            homeworks = homeworks.filter(item => item.id !== id);
            localStorage.setItem('surasak_homeworks', JSON.stringify(homeworks));
            loadHomework();
        }
    </script>
</body>
</html>
